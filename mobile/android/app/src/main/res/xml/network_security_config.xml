<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuracion de red para las compilaciones de release.

  No se permite trafico sin cifrar: el backend desplegado sirve por HTTPS, y
  los datos financieros y el token de sesion no deben viajar en claro donde
  cualquiera en la misma red pueda leerlos.

  Para desarrollo local contra http://localhost hay otra version de este
  archivo en src/debug/res/xml, que Android usa solo en las compilaciones
  de depuracion.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
