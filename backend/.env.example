# Copiar este archivo a .env  ->  cp .env.example .env
# La URL apunta al Postgres que levanta docker-compose.yml (puerto 5433 del host).
DATABASE_URL=postgresql+psycopg://finanzas:finanzas@localhost:5433/finanzas

# Clave para firmar los tokens JWT. En produccion generar una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=10080
